# Product identity. One-way door: changing any of this after a release costs users their
# menu bar arrangement, because menu bar managers (Bartender, Ice) remember an item's
# visibility by bundle id — a new id makes the item "new" again and re-hides it, silently
# undoing a setting the user made by hand.
#
# Sourced by build.sh. The hook scripts cannot source it — install.js copies them out of the
# repo into ~/.claude/control-bar/, where this file does not exist — so they carry the same
# literals inline, and .github/workflows/ci.yml fails the build if the two ever disagree.

BUNDLE_ID="io.github.infinityscripter.claude-control-bar"
EXEC="ClaudeControlBar"
APP_NAME="Agent Control Bar"
STATE_DIR=".claude/control-bar"
CASK_TOKEN="claude-control-bar"

# Bundles this project shipped under earlier names. The app quits and removes these on launch
# so a rename does not leave a second icon in the menu bar forever.
#
# Deliberately absent: com.local.claudestatusbar. That is claude-status-bar, the upstream this
# was forked from — a separate product someone may have installed on purpose. Inheriting its
# id (and the removeOldNamedBundle routine that deletes by it) would have this fork delete a
# competitor's app off the user's disk.
LEGACY_BUNDLE_IDS="com.local.mcpstatus com.local.mcpbar"
