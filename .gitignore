# A user's global ~/.gitignore may contain `/*` — that happens when the home folder is itself
# a git repository. core.excludesFile applies to EVERY repository, so without this line git
# silently sees none of this project's files and `git add -A` pretends to succeed while
# committing nothing. Measured here: scripts/, commands/ and tests/ were all invisible.
!/*

build/
*.dmg
.DS_Store
node_modules/
# Byte-compiled by the test run; a committed .pyc drifts from its source and is read by nothing
# (the app runs the .py on the system python).
__pycache__/
*.pyc

# Private maintainer notes (kept out of the public repo). Anchored to the root: git matches
# ignore patterns case-insensitively on APFS, so a bare ARCHITECTURE.md silently swallowed
# .claude/rules/architecture.md too — half the project's rules never reached the repo.
/ROADMAP.md
/ARCHITECTURE.md

# Claude Code writes per-developer local settings here when working in this repo;
# .claude/rules/ is tracked, the local overrides must not be.
.claude/settings.local.json
.autopilot/serve.*
